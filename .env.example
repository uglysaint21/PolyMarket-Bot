# Read-only prototype: public Data API calls do not require credentials.
# Never place private keys, seed phrases, or live-trading secrets in this file.

# Optional override for the Data API base URL. Must be https; the CLI reads it from the
# process environment (it does not load .env files itself, e.g. `export $(grep -v '^#' .env | xargs)`).
POLYMARKET_DATA_API_BASE_URL=https://data-api.polymarket.com/v2
